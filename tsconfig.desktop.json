{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src/desktop/**/*.ts", "src/shared/**/*.ts", "src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/backend/**/*.ts"]
}
